# -----------------------------------------------------------------------------
# Progetto Edison — variabili d'ambiente (ESEMPIO, nessun valore segreto)
# Copiare in .env e valorizzare. Non committare mai il file .env.
# In staging/produzione usare variabili d'ambiente del server o un secret manager.
# -----------------------------------------------------------------------------

APP_NAME="Edison"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC
APP_LOCALE=it
APP_FALLBACK_LOCALE=it
APP_FAKER_LOCALE=it_IT

# Aree della piattaforma. In produzione: un sottodominio per area
# (es. www.<dominio>, clienti.<dominio>, gestionale.<dominio>).
# Se il dominio è vuoto l'area è servita sotto un prefisso di percorso.
EDISON_PUBLIC_DOMAIN=
EDISON_PORTAL_DOMAIN=
EDISON_ADMIN_DOMAIN=
EDISON_PORTAL_PREFIX=area-clienti
EDISON_ADMIN_PREFIX=gestionale
EDISON_PORTAL_IDLE_MINUTES=60
EDISON_ADMIN_IDLE_MINUTES=30

# Logo ufficiale (percorso relativo a public/), da valorizzare solo con il file fornito da Edison.
EDISON_LOGO_PATH=
# Conservazione richieste di contatto (mesi). Vuoto = da definire con il titolare/DPO.
EDISON_RETENTION_CONTACT_MONTHS=

# Reverse proxy che termina TLS (IP/CIDR separati da virgola). Vuoto in sviluppo.
TRUSTED_PROXIES=

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Database della piattaforma (SQL Server) — login con permessi solo sul database EdisonPortal.
DB_CONNECTION=portal
DB_HOST=127.0.0.1
DB_PORT=1433
DB_DATABASE=EdisonPortal
DB_USERNAME=
DB_PASSWORD=
DB_ENCRYPT=yes
# Solo in sviluppo locale con certificato self-signed. In produzione: false.
DB_TRUST_SERVER_CERTIFICATE=false

# Database aziendale esistente (SQL Server) — login in SOLA LETTURA.
# Non utilizzato finché l'analisi dello schema non è consegnata e approvata.
LEGACY_DB_HOST=
LEGACY_DB_PORT=1433
LEGACY_DB_DATABASE=
LEGACY_DB_USERNAME=
LEGACY_DB_PASSWORD=
LEGACY_DB_ENCRYPT=yes
LEGACY_DB_TRUST_SERVER_CERTIFICATE=false

SESSION_DRIVER=database
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# Argon2id (valori di default sicuri; tarare sull'hardware di produzione)
ARGON_MEMORY=65536
ARGON_TIME=4
ARGON_THREADS=1

# Email (SMTP aziendale o provider transazionale). In sviluppo: log.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

VITE_APP_NAME="${APP_NAME}"
