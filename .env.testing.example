# Copiare in .env.testing (non committato) e valorizzare le credenziali del database di TEST.
APP_ENV=testing
APP_KEY=
# Generare con: php artisan key:generate --env=testing
APP_URL=http://localhost
DB_CONNECTION=portal
DB_HOST=127.0.0.1
DB_PORT=1433
DB_DATABASE=EdisonPortal_test
DB_USERNAME=
DB_PASSWORD=
DB_ENCRYPT=yes
DB_TRUST_SERVER_CERTIFICATE=true
