{
    "$schema": "https://www.schemastore.org/package.json",
    "name": "progetto-edison",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc --noEmit && vite build",
        "build:client": "vite build",
        "typecheck": "tsc --noEmit",
        "lint": "eslint resources/js tests/e2e",
        "format": "prettier --write resources/js tests/e2e",
        "format:check": "prettier --check resources/js tests/e2e",
        "test:e2e": "playwright test --trace off"
    },
    "dependencies": {
        "@fontsource-variable/inter": "^5.3.0",
        "@fontsource-variable/sora": "^5.3.0",
        "@inertiajs/react": "^3.11.0",
        "clsx": "^2.1.1",
        "lucide-react": "^1.72.0",
        "radix-ui": "^1.8.1",
        "react": "^19.3.1",
        "react-dom": "^19.3.1"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.14.0",
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.63.0",
        "@tailwindcss/vite": "^4.3.5",
        "@types/node": "^22.20.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.3.0",
        "eslint": "^10.14.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.14.0",
        "laravel-vite-plugin": "^3.2.1",
        "prettier": "^3.10.1",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "tailwindcss": "^4.3.5",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.72.2",
        "vite": "^8.3.8"
    }
}
